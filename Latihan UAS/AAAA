#include <stdio.h>
#include <string.h>

struct x {
    char shortWord[120];
    char longWord[120];
} data[120];

int main() {
    FILE *fp = fopen("testdata.in", "r");
    if (fp == NULL) {
        perror("Failed to open file");
        return 1;
    }

    int tc;
    fscanf(fp, "%d\n", &tc);
    for (int i = 0; i < tc; i++) {
        fscanf(fp, "%[^#]#%[^\n]\n", data[i].shortWord, data[i].longWord);
    }

    int n;
    char str[120] = {0};
    fscanf(fp, "%d\n", &n);
    for (int i = 0; i < n; i++) {
        fscanf(fp, "%[^\n]\n", str);
        printf("Case #%d:\n", i + 1);
        char *token = strtok(str, " ");
        
        while (token != NULL) {
            int found = 0; // Initialize found to 0 for each token
            for (int j = 0; j < tc; j++) {
                if (strcmp(token, data[j].shortWord) == 0) {
                    printf("%s", data[j].longWord);
                    found = 1; // Mark as found
                    break;
                }
            }
            if (!found) { // If not found, print the original token
                printf("%s", token);
            }
            token = strtok(NULL, " ");
            if (token != NULL) {
                printf(" "); // Print space only if there is another token
            }
        }
        printf("\n"); // New line after each case
    }

    fclose(fp); // Close the file
    return 0;
}